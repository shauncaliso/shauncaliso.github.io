---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import Message from '../components/Message.astro';
const pageTitle = "Announcements";
const allPosts = Object.values(import.meta.glob('./post/*.md', { eager: true }));
---


<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
     <title>{pageTitle}</title>
  </head>
  <body>
    <Header/>
     <title>{pageTitle}</title>
    <h2>This is my Messages page</h2>

    <p>These are my blog posts:</p>
    <ul>
     {allPosts.map((post: any) => <li><a href={post.url}>{post.frontmatter.title}</a></li>)}    
    </ul>

    <p>This is where I will post about my journey learning Astro.</p>
    <ul>
    {allPosts.map((post: any) => <Message url={post.url} title={post.frontmatter.title} />)}
    </ul>

    <p>This site will update as I complete more of the tutorial, so keep checking back and see how my journey is going!</p>

    <Footer/>

    <script>
		import "C:/Users/Admin/portfolio/src/scripts/menu.js";
	</script>

  </body>
</html>