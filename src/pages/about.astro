---
import 'C:/Users/Admin/portfolio/src/styles/global.css';
import Header from 'C:/Users/Admin/portfolio/src/components/Header.astro';
import Footer from 'C:/Users/Admin/portfolio/src/components/Footer.astro';
const pageTitle = "WhoAmI";

const whoami = {
  firstName: "Shaun Carlo Ivo",
  country: "Philippines",
  occupation: "Electronics Engineer",
  hobbies: ["photography", "guitar", "workout"],
};

const skills = ["PCB Design", "CSS", "JavaScript", "React", "Astro", "Writing Docs"];

const project1 = true;
const project2 = true;
const project3 = false;

const skillColor = "goldenrod";
const fontWeight = "bold";
const textCase = "uppercase";
---


<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
     <title>{pageTitle}</title>
     <style define:vars={{ skillColor, fontWeight, textCase }}>
        h1 {
            color: blue;
            font-size: 4rem;
        }
        .skill {
            color: var(--skillColor);
            font-size: 1.5rem;
            font-weight: var(--fontWeight);
            text-transform: var(--textCase);
        }
    </style>
  </head>
  <body>
    <Header/>
     <title>{pageTitle}</title>
    <h2>... and my new Astro site!</h2>

    <p> My name is {whoami.firstName}, and I am an {whoami.occupation} from {whoami.country}.My hobbies include: </p>
    <ul>
        {whoami.hobbies.length >=2 && 
            <li> Some of my hobbies are: {whoami.hobbies[0]} and {whoami.hobbies[1]} </li>
        }
    </ul>

    <p>My skills include:</p>
    <ul>
        {skills.map((skill) => (
            <li class ="skill" >{skill}</li>
        ))}
    </ul>

    <p> I have finished these projects so far: </p>
    <ul>
        {project1 && <li>Project 1</li>}
        {project2 && <li>Project 2</li>}
        {project3 && <li>Project 3</li>}
    </ul>

    <p>I am working through Astro's introductory tutorial. This is the second page on my website, and it's the first one I built myself!</p>

    <p>This site will update as I complete more of the tutorial, so keep checking back and see how my journey is going!</p>

    <Footer/>

    <script>
		import "C:/Users/Admin/portfolio/src/scripts/menu.js";
	</script>

  </body>
</html>