---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
const allProjects = Object.values(import.meta.glob('./projects/*.md', { eager: true }));
const pageTitle = "Projects";
---


<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
     <title>{pageTitle}</title>
  </head>
  <body>
    <Header/>
     <title>{pageTitle}</title>
    <h2>This is my Projects page</h2>

    <p>These are my project posts:</p>
    <ul>
      {allProjects.map((project: any) => <li><a href={project.url}>{project.frontmatter.title}</a></li>)} 
    </ul>

    <p>This site will update as I complete more of the tutorial, so keep checking back and see how my journey is going!</p>

    <Footer/>

    <script>
		import "C:/Users/Admin/portfolio/src/scripts/menu.js";
	</script>

  </body>
</html>